# Copy to server/.env for local runs (npm run dev). Never commit the real file.

# Gemini API key. Required in production; locally, without it the AI routes answer 503.
GEMINI_API_KEY=

# Models tried in order; any failure, timeout or invalid answer moves on to the next one.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash

# Port the server listens on.
PORT=8080

# Built web app to serve from the same origin, e.g. web/dist. Empty: API only (use Vite in dev).
STATIC_DIR=

# 1 only behind a proxy that appends the client address to X-Forwarded-For (Cloud Run does).
TRUST_PROXY=0
